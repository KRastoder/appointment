# ---------------------------------------------------------------------
# Copy this file to ".env" and adjust the values.
# Docker Compose reads .env automatically; the application reads the
# environment variables listed below.
#
# NEVER commit the real .env file (it is git-ignored).
# ---------------------------------------------------------------------

# --- PostgreSQL ---------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=doctor_appointments
DB_USERNAME=doctor
# Change this for anything that is not a local throw-away database.
DB_PASSWORD=change-me-in-production

# --- Application ---------------------------------------------------------
# Port on the host that maps to the container port 8080.
APP_PORT=8080
# Port the Spring Boot application listens on inside the container.
SERVER_PORT=8080

# --- JWT (HS256, no OAuth2) ----------------------------------------------
# HMAC signing key, minimum 32 bytes. Generate one, e.g.:
#   openssl rand -base64 48
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
# Access token lifetime and refresh token lifetime.
JWT_ACCESS_TOKEN_TTL=30m
JWT_REFRESH_TOKEN_TTL=14d

# --- First ADMIN account --------------------------------------------------
# Created on the first start only, because only an ADMIN may create accounts.
# Sign in, change the password, then set BOOTSTRAP_ADMIN_EMAIL= to disable.
BOOTSTRAP_ADMIN_EMAIL=admin@doctor-appointment.local
BOOTSTRAP_ADMIN_PASSWORD=Admin12345

# --- Local development (./mvnw spring-boot:run, IDE) ---------------------
# Point at the Compose database instead of "db":
# DB_HOST=localhost
